#include "dkli.dkh"
#!
program "createsite"
{
    #include "functions.dkh"
    #include "serialize.dkh"

    @templates_path="_templates/sites"
    @sites_path="web"
    @manifest_name="site.manifest"
    @installed_rel="_protected/site.installed.json"
    @template_root=""

    copydir::source,dest
    {
        ref files=list.files(source,"*.*")
        ref dirs=list.dirs(source)

        do dir.ensure(dest)

        for i=0;i<@count(files)
        {
            // El manifiesto de la plantilla (updatesite) no va al sitio: quedaría público en su raíz
            copiar=@true
            if source==@template_root && file.name(list.str(files,i))==@manifest_name { copiar=@false }
            if copiar
            {
                filedest=path.concat(dest, file.name(list.str(files,i)))
                do file.copy(list.str(files,i),filedest)
                do print(filedest)
            }
            exception
            {
                do print(last_error())
            }
        }
        for i=0;i<@count(dirs)
        {
            dirdest=path.concat(dest, file.name(list.str(dirs,i)))
            do copydir(list.str(dirs,i),dirdest)
        }
    }

    // Registro del sitio para updatesite: lo que se acaba de copiar, según el manifiesto de la plantilla
    write_installed::source,target,template
    {
        manifest=path.concat(source,@manifest_name)
        if not(file.exists(manifest))
        {
            // Plantilla sin site.manifest (v12-comandas, v12-kcfdi…): el registro lleva solo la plantilla, para que
            // updatev12 no la deduzca por el contenido (confundía comandas con v12 y el kiosco con v12-content-site)
            ref ahora0=now()
            fecha0=date_str(ahora0,"yyyy-MM-dd HH:mm:ss")
            new minimo
            {
                @"template": template
                @"date": fecha0
            }
            installed0=path.concat(target,@installed_rel)
            do dir.ensure(dir.name(installed0))
            do file.wtext(installed0,to.json(minimo))
            do print(installed0)
            return 0
        }

        ref m=from.json(file.rtext(manifest))
        ref files=list.create()
        if field.exist(m,"files")
        {
            ref mf=field.obj(m,"files")
            for i=0;i<@count(mf)
            {
                ref e=@item(mf,i)
                new f
                {
                    @"path": trim(@@(e,"$path"))
                    @"sha256": trim(@@(e,"$sha256"))
                }
                do list.add(files,f)
            }
        }
        ref ahora=now()
        fecha=date_str(ahora,"yyyy-MM-dd HH:mm:ss")
        new reg
        {
            @"template": template
            @"version": trim(@@(m,"$version"))
            @"date": fecha
        }
        reg<"files*">: files

        installed=path.concat(target,@installed_rel)
        do dir.ensure(dir.name(installed))
        do file.wtext(installed,to.json(reg))
        do print(installed)
        return 0
        exception
        {
            do print("No se pudo escribir el registro del sitio (" + @installed_rel + "): " + last_error())
        }
    }

    print_error::err
    {
        do print("")
        do print("-  ERROR -")
        do print(err)
        do print("------------------------------------------------------------")
        do print("")
        do print("- USO DE LA HERRAMIENTA -")
        do print("./dkl createsite nombre_plantilla host_sitio_web")
        do print("")
        do print("Ejemplo:")
        do print("\t./dkl createsite blank subdominio.dominio.com")
        do print("Donde:")
        do print("\t blank=Es la plantilla de sitio Web vacío")
        do print("\t subdominio.dominio.com=Es El nombre de host para el nuevo sitio Web")
        do print("------------------------------------------------------------")
    }

    arg1=""
    arg2=""
    codeblock
    {
        ref args=list.create_from_fields( commandline(":") )
        arg1=trim(list.str(args,1))
        arg2=trim(list.str(args,2))
        exception{}
    }

    if arg1=="" || arg2=="" 
    { 
        do rise_error(0,"Faltan parámetros.")
    }
    source=path.concat(@templates_path,arg1)
    target=path.concat(@sites_path,arg2)

    if not(dir.exists(source))
    {
        do rise_error(0,"No existe la plantilla indicada '"+arg1+"'")
    }

    @template_root=source
    do copydir(source,target)
    do write_installed(source,target,arg1)
    exception
    {
        do print_error(last_error())
    }
    
}